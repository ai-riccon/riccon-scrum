{
  "name": "riccon-scrum",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "smoke:acp": "npm run smoke:acp -w server",
    "smoke:discovery": "npm run smoke:discovery -w server",
    "eval:discovery": "npm run eval:discovery -w server",
    "check:tasks": "npm run check:tasks -w server",
    "check:documents": "npm run check:documents -w server",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}